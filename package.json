{
  "name": "blocknsfw",
  "version": "1.7.3",
  "private": true,
  "description": "BlockNSFW browser extension source and tooling.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "build:chrome": "node scripts/build-extension.mjs --target chrome",
    "build:firefox": "node scripts/build-extension.mjs --target firefox",
    "build:zip": "node scripts/build-extension.mjs --zip",
    "validate:build": "node scripts/validate-build.mjs",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --output text",
    "perf:firefox": "node scripts/perf/firefox-render-benchmark.mjs"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "web-ext": "^8.3.0"
  }
}
